{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checksum",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/r/*", "/og/*"],
  },
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"] }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "checksum.dwainosaur.com", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "PUZZLES", "id": "3f3a19381382454f8c1df5c71f9167b4" }],
  "durable_objects": { "bindings": [{ "name": "RESULTS", "class_name": "DayResults" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DayResults"] }],
  "ratelimits": [
    { "name": "API_RATE", "namespace_id": "1", "simple": { "limit": 60, "period": 60 } },
  ],
}
